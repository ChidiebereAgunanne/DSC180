    // skipped because the user already chose), repeat calls are no-ops.

    // Paths and pattern where the banner should be hidden when suppression is on.
    // Funnel paths are exact-prefix matches; event hub uses the /events parent route;
    // how-to-watch replicates the regex from how-to-watch.utility.ts.
    var HOW_TO_WATCH_PATTERN = /(?:^|[/-])how-to-watch(?![a-z])/
    var SUPPRESSED_PREFIXES = ['/signup', '/create-account', '/register', '/login', '/plans', '/pay', '/events']

